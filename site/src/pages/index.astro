---
import Base from "../layouts/Base.astro";
import AutofillDemo from "../components/AutofillDemo.astro";
import PlatformIcon from "../components/PlatformIcon.astro";
import StatusPill from "../components/StatusPill.astro";
import ReleaseItem from "../components/ReleaseItem.astro";
import GitHubMark from "../components/GitHubMark.astro";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import KeyRound from "@lucide/astro/icons/key-round";
import Fingerprint from "@lucide/astro/icons/fingerprint-pattern";
import LayoutGrid from "@lucide/astro/icons/layout-grid";
import Keyboard from "@lucide/astro/icons/keyboard";
import BellOff from "@lucide/astro/icons/bell-off";
import UserRoundCheck from "@lucide/astro/icons/user-round-check";
import ShieldCheck from "@lucide/astro/icons/shield-check";
import Server from "@lucide/astro/icons/server";
import EyeOff from "@lucide/astro/icons/eye-off";
import RefreshCw from "@lucide/astro/icons/refresh-cw";
import { platforms, github } from "../data/platforms";
import { getReleases, latestFor, formatDate } from "../lib/releases";

const releases = await getReleases();
const latest = releases.find((r) => !r.prerelease) ?? releases[0];
const recent = releases.slice(0, 3);

const platformCards = platforms.map((p) => {
  const release = latestFor(releases, p.id);
  return { ...p, release, state: release ? ("available" as const) : p.status };
});

const features = [
  {
    icon: KeyRound,
    title: "Autofill from every vault",
    text: "Inline suggestions come from all unlocked accounts at once, each labelled with the account it belongs to.",
    wide: true,
  },
  {
    icon: UserRoundCheck,
    title: "Save to the right vault",
    text: "New logins come with an account picker that remembers your choice per site. Password updates go to the account that owns the login.",
    wide: true,
  },
  {
    icon: Fingerprint,
    title: "Passkeys across accounts",
    text: "Sign in with a passkey from any unlocked account, and pick where new passkeys are stored.",
  },
  {
    icon: LayoutGrid,
    title: "Combined view",
    text: "Browse every vault in one list, with folders, collections and Sends from all accounts, each item marked by its owner.",
  },
  {
    icon: BellOff,
    title: "Fewer pointless prompts",
    text: "No “save this login?” prompt for logins you already have in any of your accounts.",
  },
  {
    icon: Keyboard,
    title: "Shortcuts that keep looking",
    text: "Keyboard-shortcut autofill falls back to your other accounts when the active one has no match.",
  },
];

const trust = [
  {
    icon: ShieldCheck,
    title: "Bitwarden’s encryption, untouched",
    text: "Your vaults stay end-to-end encrypted by the same code as the official apps. Multiwarden only adds small hooks on top.",
  },
  {
    icon: Server,
    title: "Your servers, nobody else’s",
    text: "It talks only to the Bitwarden servers you choose: bitwarden.com, bitwarden.eu or your own self-hosted instance.",
  },
  {
    icon: EyeOff,
    title: "No tracking",
    text: "No analytics, no advertising and no Multiwarden servers. Nothing is sent to the developers.",
  },
  {
    icon: RefreshCw,
    title: "Follows every Bitwarden release",
    text: "Upstream releases are merged automatically, so you keep getting Bitwarden’s fixes and features.",
  },
];

const faq = [
  {
    q: "Is Multiwarden an official Bitwarden app?",
    a: "No. Multiwarden is an independent, open-source fork of the Bitwarden apps. It is not affiliated with or supported by Bitwarden, Inc.",
  },
  {
    q: "Do I need a special account or server?",
    a: "No. Sign in with your existing Bitwarden accounts, on bitwarden.com, bitwarden.eu or a self-hosted server. Personal, work and family accounts can all be unlocked side by side.",
  },
  {
    q: "Can I keep the official extension installed?",
    a: "Turn the official Bitwarden extension off while you use Multiwarden. Two password managers on one page fight over autofill and save prompts.",
  },
  {
    q: "Is my data safe?",
    a: "Multiwarden keeps Bitwarden’s encryption and sync code as it is, and its own additions are small and open for anyone to review on GitHub. Your vault data only ever goes to the Bitwarden server you sign in to.",
  },
  {
    q: "Which platforms are supported?",
    a: "The browser extension is available now for Chrome, Edge, Opera, Brave, Vivaldi, Firefox and Safari. Android is next, then desktop and iOS.",
  },
];
---

<Base>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(to_right,rgb(0_0_0/0.045)_1px,transparent_1px),linear-gradient(to_bottom,rgb(0_0_0/0.045)_1px,transparent_1px)] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,black,transparent)] bg-[size:56px_56px] dark:bg-[linear-gradient(to_right,rgb(255_255_255/0.05)_1px,transparent_1px),linear-gradient(to_bottom,rgb(255_255_255/0.05)_1px,transparent_1px)]"
    >
    </div>
    <div
      class="pointer-events-none absolute top-[-14rem] left-1/2 -z-10 h-[36rem] w-[64rem] -translate-x-1/2 rounded-full bg-gradient-to-b from-brand-500/25 via-violet-500/10 to-transparent blur-3xl"
    >
    </div>

    <div class="container-page grid items-center gap-16 pt-16 pb-24 sm:pt-24 lg:grid-cols-[1.05fr_1fr] lg:gap-10 lg:pt-28">
      <div class="hero-copy text-center lg:text-left">
        <a
          href={latest ? "/releases/" : "/download/"}
          class="group inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-white/70 py-1 pr-3 pl-1 text-sm text-zinc-600 shadow-sm backdrop-blur transition hover:border-brand-500/40 dark:border-white/10 dark:bg-white/5 dark:text-zinc-300"
        >
          <span class="pill bg-brand-500 text-white">New</span>
          {latest ? `${latest.platformName} ${latest.version} is out` : "Browser extension out now, Android next"}
          <ArrowRight class="size-3.5 transition group-hover:translate-x-0.5" />
        </a>

        <h1 class="mt-7 text-5xl leading-[1.02] font-semibold tracking-[-0.035em] text-balance sm:text-6xl lg:text-7xl">
          All your vaults, <span class="text-gradient">working as one.</span>
        </h1>
        <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-pretty text-zinc-600 lg:mx-0 dark:text-zinc-400">
          Multiwarden is a Bitwarden client for people with more than one account. Autofill, saving and passkeys
          work across every vault you have unlocked, at the same time.
        </p>

        <div class="mt-9 flex flex-wrap items-center justify-center gap-3 lg:justify-start">
          <a
            href="/download/"
            class="btn btn-primary !px-6 !py-3 text-base"
            data-download-cta
            data-available={platformCards.filter((p) => p.release).map((p) => p.id).join(",")}
          >
            <span>Download</span>
            <ArrowRight class="size-4" />
          </a>
          <a href={github.org} class="btn btn-secondary !px-6 !py-3 text-base">
            <GitHubMark class="size-4" />
            View source
          </a>
        </div>
        <p class="mt-5 text-sm text-zinc-500">
          Free and open source · Works with bitwarden.com, bitwarden.eu and self-hosted
        </p>
      </div>

      <div class="hero-visual">
        <AutofillDemo />
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="container-page scroll-mt-24 py-24">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="eyebrow">Multi-account, done properly</p>
      <h2 class="mt-3 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
        Every unlocked account takes part.
      </h2>
      <p class="mt-5 text-lg text-pretty text-zinc-600 dark:text-zinc-400">
        The official apps can sign in to several accounts but only use the active one. Multiwarden keeps all of
        them in play, plus a few quality-of-life features along the way.
      </p>
    </div>

    <div class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        features.map((f) => (
          <div
            data-reveal
            class:list={[
              "card group relative overflow-hidden p-7 transition duration-300 hover:-translate-y-0.5 hover:border-brand-500/30 hover:shadow-xl hover:shadow-brand-500/5",
              f.wide && "lg:col-span-2",
            ]}
          >
            <div class="absolute -top-24 -right-24 size-48 rounded-full bg-brand-500/10 opacity-0 blur-2xl transition duration-500 group-hover:opacity-100" />
            <span class="grid size-11 place-items-center rounded-xl bg-gradient-to-br from-brand-500 to-violet-500 text-white shadow-lg shadow-brand-500/25">
              <f.icon class="size-5" />
            </span>
            <h3 class="mt-5 text-lg font-semibold tracking-tight">{f.title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-zinc-600 dark:text-zinc-400">{f.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Trust -->
  <section class="relative isolate overflow-hidden py-24">
    <div class="absolute inset-0 -z-10 bg-zinc-950"></div>
    <div
      class="absolute top-0 left-1/2 -z-10 h-80 w-[56rem] -translate-x-1/2 rounded-full bg-brand-500/25 blur-3xl"
    >
    </div>
    <div class="container-page text-white">
      <div class="grid gap-14 lg:grid-cols-[1fr_1.3fr] lg:gap-20">
        <div data-reveal>
          <p class="text-sm font-semibold tracking-wide text-brand-300">Built on Bitwarden</p>
          <h2 class="mt-3 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
            Same security. More of your accounts.
          </h2>
          <p class="mt-5 text-lg text-pretty text-zinc-400">
            Multiwarden is a fork of the official, open-source Bitwarden apps. New logic lives in separate files
            with small hooks into Bitwarden’s code, so it stays easy to audit and easy to keep up to date.
          </p>
          <a href={github.org} class="btn mt-8 border border-white/15 bg-white/5 text-white hover:bg-white/10">
            <GitHubMark class="size-4" />
            Read the code
          </a>
        </div>
        <div class="grid gap-x-10 gap-y-10 sm:grid-cols-2">
          {
            trust.map((t) => (
              <div data-reveal>
                <span class="grid size-10 place-items-center rounded-lg bg-white/10 text-brand-300 ring-1 ring-white/10">
                  <t.icon class="size-5" />
                </span>
                <h3 class="mt-4 font-semibold">{t.title}</h3>
                <p class="mt-2 text-[15px] leading-relaxed text-zinc-400">{t.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Platforms -->
  <section id="platforms" class="container-page scroll-mt-24 py-24">
    <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div class="max-w-xl">
        <p class="eyebrow">Platforms</p>
        <h2 class="mt-3 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">Wherever you use Bitwarden.</h2>
      </div>
      <a href="/download/" class="btn btn-secondary">All downloads <ArrowRight class="size-4" /></a>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        platformCards.map((p) => (
          <a
            href={`/download/#${p.id}`}
            data-reveal
            class:list={[
              "card group flex flex-col p-6 transition duration-300 hover:-translate-y-0.5 hover:border-brand-500/30 hover:shadow-xl hover:shadow-brand-500/5",
              p.state === "planned" && "opacity-80",
            ]}
          >
            <div class="flex items-center justify-between">
              <span class="grid size-11 place-items-center rounded-xl bg-zinc-100 text-zinc-700 transition group-hover:bg-brand-500 group-hover:text-white dark:bg-white/10 dark:text-zinc-200">
                <PlatformIcon id={p.id} />
              </span>
              <StatusPill status={p.state} />
            </div>
            <h3 class="mt-6 text-lg font-semibold tracking-tight">{p.name}</h3>
            <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">{p.blurb}</p>
            <p class="mt-auto pt-6 text-sm font-medium text-zinc-900 dark:text-zinc-100">
              {p.release ? (
                <>
                  {p.release.version}
                  <span class="font-normal text-zinc-500"> · {formatDate(p.release.date)}</span>
                </>
              ) : p.state === "soon" ? (
                "In development"
              ) : (
                "On the roadmap"
              )}
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Latest releases -->
  <section class="container-page py-12">
    <div class="card overflow-hidden p-8 sm:p-12" data-reveal>
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow">Changelog</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight">Latest releases</h2>
        </div>
        <a href="/releases/" class="btn btn-secondary">Every release <ArrowRight class="size-4" /></a>
      </div>
      {
        recent.length ? (
          <div class="relative mt-10 space-y-10 before:absolute before:top-2 before:bottom-2 before:left-3.5 before:w-px before:bg-zinc-200 sm:before:left-[1.125rem] dark:before:bg-white/10">
            {recent.map((r, i) => (
              <ReleaseItem release={r} latest={r === latest} />
            ))}
          </div>
        ) : (
          <p class="mt-8 text-zinc-500">
            The first release is on its way. Follow along on <a class="text-brand-600 underline dark:text-brand-400" href={github.org}>GitHub</a>.
          </p>
        )
      }
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="container-page grid scroll-mt-24 gap-12 py-24 lg:grid-cols-[1fr_1.6fr]">
    <div data-reveal>
      <p class="eyebrow">FAQ</p>
      <h2 class="mt-3 text-4xl font-semibold tracking-tight">Good questions.</h2>
      <p class="mt-4 text-zinc-600 dark:text-zinc-400">
        Something else? <a class="text-brand-600 underline underline-offset-2 dark:text-brand-400" href={github.issues}>Ask on GitHub</a>.
      </p>
    </div>
    <div class="divide-y divide-zinc-200 border-y border-zinc-200 dark:divide-white/10 dark:border-white/10" data-reveal>
      {
        faq.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden">
              {item.q}
              <span class="grid size-7 shrink-0 place-items-center rounded-full border border-zinc-200 text-zinc-500 transition group-open:rotate-45 dark:border-white/15">
                +
              </span>
            </summary>
            <p class="mt-3 pr-12 leading-relaxed text-zinc-600 dark:text-zinc-400">{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="container-page">
    <div
      class="relative isolate overflow-hidden rounded-3xl bg-gradient-to-br from-brand-600 via-brand-500 to-violet-600 px-8 py-16 text-center text-white shadow-2xl shadow-brand-500/25 sm:px-16"
      data-reveal
    >
      <div class="absolute -top-24 -left-24 -z-10 size-72 rounded-full bg-white/20 blur-3xl"></div>
      <div class="absolute -right-20 -bottom-28 -z-10 size-80 rounded-full bg-fuchsia-400/30 blur-3xl"></div>
      <img src="/logo.png" alt="" class="mx-auto size-16 rounded-2xl shadow-xl ring-1 ring-white/30" />
      <h2 class="mt-6 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">All your vaults, working as one.</h2>
      <p class="mx-auto mt-4 max-w-lg text-lg text-white/80">Free, open source, and ready in a minute.</p>
      <a href="/download/" class="btn mt-9 !px-6 !py-3 bg-white text-base text-brand-700 shadow-xl hover:bg-brand-50">
        Get Multiwarden <ArrowRight class="size-4" />
      </a>
    </div>
  </section>
</Base>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > * {
      animation: hero-in 0.9s var(--ease-out-expo) both;
    }
    .hero-copy > :nth-child(2) {
      animation-delay: 0.06s;
    }
    .hero-copy > :nth-child(3) {
      animation-delay: 0.12s;
    }
    .hero-copy > :nth-child(4) {
      animation-delay: 0.18s;
    }
    .hero-copy > :nth-child(5) {
      animation-delay: 0.24s;
    }
    .hero-visual {
      animation: hero-in 1.1s var(--ease-out-expo) 0.15s both;
    }
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(18px);
      filter: blur(6px);
    }
  }
</style>

<script>
  // Name the visitor's browser or OS on the download button, when Multiwarden is out for it.
  import { detectBrowser } from "../lib/detect";
  const cta = document.querySelector<HTMLAnchorElement>("[data-download-cta]");
  const detected = detectBrowser();
  const available = (cta?.dataset.available ?? "").split(",");
  if (cta && detected && available.includes(detected.platform)) {
    cta.querySelector("span")!.textContent = `Download for ${detected.label}`;
    cta.href = `/download/#${detected.platform}`;
  }
</script>
