---
import Base from "../layouts/Base.astro";
import InlineMenuDemo from "../components/InlineMenuDemo.astro";
import SaveBarDemo from "../components/SaveBarDemo.astro";
import PlatformIcon from "../components/PlatformIcon.astro";
import StatusPill from "../components/StatusPill.astro";
import GitHubMark from "../components/GitHubMark.astro";
import StoreIcon from "../components/StoreIcon.astro";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Check from "@lucide/astro/icons/check";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { platforms, github } from "../data/platforms";
import { getReleases, latestFor } from "../lib/releases";

const releases = await getReleases();
const latest = releases.find((r) => !r.prerelease) ?? releases[0];
const chromeStore = platforms.find((p) => p.id === "browser")?.stores.find((s) => s.label === "Chrome Web Store");

const platformCards = platforms.map((p) => {
  const release = latestFor(releases, p.id);
  return { ...p, release, state: release ? ("available" as const) : p.status };
});

// Smaller features, one line each. All are in the browser extension today.
const extras = [
  "Passkeys from any account",
  "No save prompt for logins you already have",
  "Shortcut autofill falls back to other accounts",
  "Option to hide Premium notices",
];

const trust = [
  "Bitwarden’s encryption and sync, unchanged",
  "Syncs only with your Bitwarden server",
  "No tracking, nothing sent to the developers",
  "Open source, GPL-3.0",
];

const faq = [
  {
    q: "Is this an official Bitwarden app?",
    a: "No. Multiwarden is an independent, open-source fork, not affiliated with Bitwarden, Inc.",
  },
  {
    q: "Which servers does it work with?",
    a: "Your existing accounts on bitwarden.com, bitwarden.eu or a self-hosted server.",
  },
  {
    q: "Has it been audited?",
    a: "No. Bitwarden’s own code is unchanged, and every Multiwarden change is public on GitHub, but Multiwarden itself has not had an independent security audit.",
  },
];
---

<Base>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(to_right,rgb(0_0_0/0.045)_1px,transparent_1px),linear-gradient(to_bottom,rgb(0_0_0/0.045)_1px,transparent_1px)] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,black,transparent)] bg-[size:56px_56px] dark:bg-[linear-gradient(to_right,rgb(255_255_255/0.05)_1px,transparent_1px),linear-gradient(to_bottom,rgb(255_255_255/0.05)_1px,transparent_1px)]"
    >
    </div>
    <div
      class="pointer-events-none absolute top-[-14rem] left-1/2 -z-10 h-[36rem] w-[64rem] -translate-x-1/2 rounded-full bg-gradient-to-b from-brand-500/25 via-violet-500/10 to-transparent blur-3xl"
    >
    </div>

    <div class="container-page grid items-center gap-16 pt-16 pb-24 sm:pt-24 lg:grid-cols-[1fr_1fr] lg:gap-12 lg:pt-28">
      <div class="hero-copy text-center lg:text-left">
        <a
          href={latest ? "/releases/" : "/download/"}
          class="group inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-white/70 py-1 pr-3 pl-1 text-sm text-zinc-600 shadow-sm backdrop-blur transition hover:border-brand-500/40 dark:border-white/10 dark:bg-white/5 dark:text-zinc-300"
        >
          <span class="pill bg-brand-500 text-white">New</span>
          {latest ? `${latest.platformName} ${latest.version} is out` : "Browser extension and Android in development"}
          <ArrowRight class="size-3.5 transition group-hover:translate-x-0.5" />
        </a>

        <h1 class="mt-7 text-5xl leading-[1.02] font-semibold tracking-[-0.035em] text-balance sm:text-6xl lg:text-7xl">
          All your vaults, <span class="text-gradient">working as one.</span>
        </h1>
        <p class="mx-auto mt-6 max-w-md text-lg text-pretty text-zinc-600 lg:mx-0 dark:text-zinc-400">
          An unofficial Bitwarden client that autofills, saves and signs in from every account you have unlocked.
        </p>

        <div class="mt-9 flex flex-wrap items-center justify-center gap-3 lg:justify-start">
          <a
            href="/download/"
            class="btn btn-primary !px-6 !py-3 text-base"
            data-download-cta
            data-available={platformCards
              .filter((p) => p.release)
              .map((p) => p.id)
              .join(",")}
          >
            <span>Download</span>
            <ArrowRight class="size-4" />
          </a>
          {
            chromeStore && (
              <a href={chromeStore.url} class="btn btn-secondary !px-6 !py-3 text-base" data-store-cta>
                <StoreIcon id="chrome" class="size-4" />
                Chrome Web Store
                <ArrowUpRight class="size-4" />
              </a>
            )
          }
          <a href={github.org} class="btn btn-secondary !px-6 !py-3 text-base">
            <GitHubMark class="size-4" />
            Source
          </a>
        </div>
      </div>

      <div class="hero-visual">
        <InlineMenuDemo />
        <p class="mt-6 text-center text-sm text-zinc-500">Logins from both accounts, labelled with the account they belong to.</p>
      </div>
    </div>
  </section>

  <!-- Features: the real UI, one line each -->
  <section id="features" class="container-page scroll-mt-24 space-y-28 py-24">
    <div class="feature" data-reveal>
      <div class="feature-copy">
        <p class="eyebrow">Save</p>
        <h2 class="feature-title">Save to the right account.</h2>
        <p class="feature-text">Pick the account in the save prompt. Multiwarden remembers it for the site.</p>
      </div>
      <div class="feature-visual">
        <div class="stage pb-28">
          <SaveBarDemo />
        </div>
      </div>
    </div>

    <div class="feature feature--flip" data-reveal>
      <div class="feature-copy">
        <p class="eyebrow">Combined view</p>
        <h2 class="feature-title">Every vault in one list.</h2>
        <p class="feature-text">Items from all unlocked accounts side by side, each marked with its account.</p>
      </div>
      <div class="feature-visual">
        <div class="stage">
          <img
            src="/screenshots/popup-vault-light.png"
            alt="The Multiwarden popup in Combined view, with GitHub logins from a personal and a work account."
            width="960"
            height="1280"
            loading="lazy"
            class="popup dark:hidden"
          />
          <img
            src="/screenshots/popup-vault-dark.png"
            alt="The Multiwarden popup in Combined view, dark theme."
            width="960"
            height="1280"
            loading="lazy"
            class="popup hidden dark:block"
          />
        </div>
      </div>
    </div>

    <div class="feature" data-reveal>
      <div class="feature-copy">
        <p class="eyebrow">Accounts</p>
        <h2 class="feature-title">Combined, or one at a time.</h2>
        <p class="feature-text">Switch from the avatar menu whenever you want a single vault.</p>
      </div>
      <div class="feature-visual">
        <div class="stage">
          <img
            src="/screenshots/popup-account-menu.png"
            alt="The avatar menu in the Multiwarden popup: Combined, each account, and Manage accounts."
            width="960"
            height="1280"
            loading="lazy"
            class="popup"
          />
        </div>
      </div>
    </div>

    <ul class="flex flex-wrap justify-center gap-3" data-reveal>
      {
        extras.map((e) => (
          <li class="card flex items-center gap-2 !rounded-full px-4 py-2 text-sm font-medium">
            <Check class="size-4 text-brand-500" />
            {e}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Trust -->
  <section class="relative isolate overflow-hidden py-20">
    <div class="absolute inset-0 -z-10 bg-zinc-950"></div>
    <div class="absolute top-0 left-1/2 -z-10 h-72 w-[56rem] -translate-x-1/2 rounded-full bg-brand-500/25 blur-3xl"></div>
    <div class="container-page text-center text-white" data-reveal>
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">Built on Bitwarden.</h2>
      <ul class="mx-auto mt-10 grid max-w-4xl gap-4 text-left sm:grid-cols-2">
        {
          trust.map((t) => (
            <li class="flex items-center gap-3 rounded-xl bg-white/5 px-5 py-4 ring-1 ring-white/10">
              <Check class="size-5 shrink-0 text-brand-300" />
              {t}
            </li>
          ))
        }
      </ul>
      <a href={github.org} class="btn mt-10 border border-white/15 bg-white/5 text-white hover:bg-white/10">
        <GitHubMark class="size-4" /> Read the code
      </a>
    </div>
  </section>

  <!-- Platforms -->
  <section id="platforms" class="container-page scroll-mt-24 py-24">
    <h2 class="text-center text-3xl font-semibold tracking-tight sm:text-4xl" data-reveal>Platforms</h2>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        platformCards.map((p) => (
          <a
            href={`/download/#${p.id}`}
            data-reveal
            class="card group flex items-center gap-4 p-5 transition duration-300 hover:-translate-y-0.5 hover:border-brand-500/30"
          >
            <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-zinc-100 text-zinc-700 transition group-hover:bg-brand-500 group-hover:text-white dark:bg-white/10 dark:text-zinc-200">
              <PlatformIcon id={p.id} />
            </span>
            <span class="min-w-0">
              <span class="block font-semibold tracking-tight">{p.name}</span>
              <span class="mt-1 flex flex-wrap items-center gap-2">
                <StatusPill status={p.state} />
                {p.release && <span class="text-xs text-zinc-500">{p.release.version}</span>}
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="container-page max-w-3xl scroll-mt-24 pb-24">
    <div class="divide-y divide-zinc-200 border-y border-zinc-200 dark:divide-white/10 dark:border-white/10" data-reveal>
      {
        faq.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden">
              {item.q}
              <span class="grid size-7 shrink-0 place-items-center rounded-full border border-zinc-200 text-zinc-500 transition group-open:rotate-45 dark:border-white/15">
                +
              </span>
            </summary>
            <p class="mt-3 pr-12 text-zinc-600 dark:text-zinc-400">{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="container-page">
    <div
      class="relative isolate overflow-hidden rounded-3xl bg-gradient-to-br from-brand-600 via-brand-500 to-violet-600 px-8 py-14 text-center text-white shadow-2xl shadow-brand-500/25 sm:px-16"
      data-reveal
    >
      <div class="absolute -top-24 -left-24 -z-10 size-72 rounded-full bg-white/20 blur-3xl"></div>
      <div class="absolute -right-20 -bottom-28 -z-10 size-80 rounded-full bg-fuchsia-400/30 blur-3xl"></div>
      <h2 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">All your vaults, working as one.</h2>
      <a href="/download/" class="btn mt-8 !px-6 !py-3 bg-white text-base text-brand-700 shadow-xl hover:bg-brand-50">
        Get Multiwarden <ArrowRight class="size-4" />
      </a>
    </div>
  </section>
</Base>

<style>
  @reference "../styles/global.css";

  .feature {
    @apply grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-20;
  }
  .feature > * {
    min-width: 0;
  }
  .feature--flip .feature-copy {
    @apply lg:order-2;
  }
  .feature-copy {
    @apply text-center lg:text-left;
  }
  .feature-title {
    @apply mt-3 text-4xl font-semibold tracking-tight text-balance sm:text-5xl;
  }
  .feature-text {
    @apply mx-auto mt-4 max-w-md text-lg text-pretty text-zinc-600 lg:mx-0 dark:text-zinc-400;
  }
  .stage {
    @apply relative flex justify-center overflow-hidden rounded-3xl bg-gradient-to-br from-brand-500/15 via-violet-500/10 to-fuchsia-400/10 px-6 pt-10 sm:px-10;
  }
  /* Up to the popup's real width (480 px), so the account avatars stay legible. */
  .popup {
    @apply h-auto w-full max-w-[30rem] self-start rounded-t-2xl shadow-2xl ring-1 shadow-brand-950/20 ring-black/5;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > * {
      animation: hero-in 0.9s var(--ease-out-expo) both;
    }
    .hero-copy > :nth-child(2) {
      animation-delay: 0.06s;
    }
    .hero-copy > :nth-child(3) {
      animation-delay: 0.12s;
    }
    .hero-copy > :nth-child(4) {
      animation-delay: 0.18s;
    }
    .hero-visual {
      animation: hero-in 1.1s var(--ease-out-expo) 0.15s both;
    }
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(18px);
      filter: blur(6px);
    }
  }
</style>

<script>
  // Name the visitor's browser or OS on the download button, when Multiwarden is out for it.
  import { detectBrowser } from "../lib/detect";
  const cta = document.querySelector<HTMLAnchorElement>("[data-download-cta]");
  const detected = detectBrowser();
  const available = (cta?.dataset.available ?? "").split(",");
  const store = document.querySelector<HTMLAnchorElement>("[data-store-cta]");
  if (cta && store && detected?.variant === "chrome") {
    // Chrome, Brave and Vivaldi install from the Chrome Web Store.
    cta.querySelector("span")!.textContent = `Add to ${detected.label}`;
    cta.href = store.href;
    const logo = store.querySelector("svg");
    if (logo) cta.prepend(logo);
    store.remove();
  } else if (cta && detected && available.includes(detected.platform)) {
    cta.querySelector("span")!.textContent = `Download for ${detected.label}`;
    cta.href = `/download/#${detected.platform}`;
  }
</script>
