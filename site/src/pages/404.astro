---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
  <section class="container-page py-32 text-center">
    <p class="text-gradient text-7xl font-semibold tracking-tight">404</p>
    <h1 class="mt-4 text-2xl font-semibold">This page doesn’t exist.</h1>
    <p class="mt-2 text-zinc-600 dark:text-zinc-400">It may have moved when the site was rebuilt.</p>
    <a href="/" class="btn btn-primary mt-8">Back to the homepage</a>
  </section>
</Base>
