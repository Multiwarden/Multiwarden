---
import Base from "../layouts/Base.astro";
import PlatformIcon from "../components/PlatformIcon.astro";
import StatusPill from "../components/StatusPill.astro";
import GitHubMark from "../components/GitHubMark.astro";
import Download from "@lucide/astro/icons/download";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { platforms, github } from "../data/platforms";
import { getReleases, latestFor, formatDate, formatSize } from "../lib/releases";

const releases = await getReleases();
const sections = platforms.map((p) => {
  const release = latestFor(releases, p.id);
  return { ...p, release, state: release ? ("available" as const) : p.status };
});
---

<Base title="Download" description="Download Multiwarden for your browser, Android and more.">
  <section class="relative isolate overflow-hidden">
    <div
      class="pointer-events-none absolute top-[-16rem] left-1/2 -z-10 h-[30rem] w-[56rem] -translate-x-1/2 rounded-full bg-gradient-to-b from-brand-500/20 to-transparent blur-3xl"
    >
    </div>
    <div class="container-page pt-16 pb-10 text-center sm:pt-24">
      <p class="eyebrow">Download</p>
      <h1 class="mt-3 text-5xl font-semibold tracking-[-0.03em] text-balance sm:text-6xl">Get Multiwarden</h1>
      <p class="mx-auto mt-5 max-w-xl text-lg text-pretty text-zinc-600 dark:text-zinc-400">
        Free and open source. Pick your platform, sign in to your Bitwarden accounts, and unlock them all.
      </p>
    </div>
  </section>

  <!-- Platform switcher -->
  <nav
    class="sticky top-16 z-30 border-y border-zinc-200/70 bg-white/80 backdrop-blur-xl dark:border-white/10 dark:bg-zinc-950/80"
    aria-label="Platforms"
  >
    <ul class="container-page flex gap-1 overflow-x-auto py-2 text-sm">
      {
        sections.map((p) => (
          <li>
            <a
              href={`#${p.id}`}
              class="flex items-center gap-2 rounded-full px-3.5 py-1.5 whitespace-nowrap text-zinc-600 transition hover:bg-zinc-100 hover:text-zinc-950 dark:text-zinc-400 dark:hover:bg-white/10 dark:hover:text-white"
            >
              <PlatformIcon id={p.id} class="size-4" />
              {p.name}
              {p.state !== "available" && <span class="text-xs text-zinc-400">· {p.state === "soon" ? "soon" : "planned"}</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="container-page space-y-6 py-12">
    {
      sections.map((p) => (
        <section id={p.id} class="card scroll-mt-36 p-6 sm:p-10" data-reveal>
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="flex items-center gap-4">
              <span class="grid size-12 place-items-center rounded-xl bg-gradient-to-br from-brand-500 to-violet-500 text-white shadow-lg shadow-brand-500/25">
                <PlatformIcon id={p.id} class="size-6" />
              </span>
              <div>
                <h2 class="text-2xl font-semibold tracking-tight">{p.name}</h2>
                <p class="text-sm text-zinc-500 dark:text-zinc-400">{p.blurb}</p>
              </div>
            </div>
            <div class="flex items-center gap-3 text-sm">
              {p.release && (
                <a href={p.release.url} class="text-zinc-500 hover:text-zinc-950 dark:hover:text-white">
                  {p.release.version} · {formatDate(p.release.date)}
                </a>
              )}
              <StatusPill status={p.state} />
            </div>
          </div>

          {p.stores.length > 0 && (
            <div class="mt-8 flex flex-wrap gap-3">
              {p.stores.map((s) => (
                <a href={s.url} class="btn btn-primary">
                  {s.label} <ArrowUpRight class="size-4" />
                </a>
              ))}
            </div>
          )}

          {p.release && p.release.downloads.length > 0 && (
            <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {p.release.downloads.map((d) => (
                <a
                  href={d.url}
                  data-variant={d.variantId}
                  class="group relative flex items-center justify-between gap-4 rounded-xl border border-zinc-200 bg-white p-4 transition hover:-translate-y-0.5 hover:border-brand-500/40 hover:shadow-lg hover:shadow-brand-500/5 data-[recommended]:border-brand-500 data-[recommended]:ring-4 data-[recommended]:ring-brand-500/10 dark:border-white/10 dark:bg-white/[0.03]"
                >
                  <span>
                    <span class="flex items-center gap-2 font-semibold">
                      {d.label}
                      <span class="pill hidden bg-brand-500 text-white group-data-[recommended]:inline-flex">Your browser</span>
                    </span>
                    <span class="mt-0.5 block text-xs text-zinc-500">
                      {d.note ? `${d.note} · ` : ""}
                      {formatSize(d.size)}
                    </span>
                  </span>
                  <span class="grid size-9 shrink-0 place-items-center rounded-full bg-zinc-100 text-zinc-600 transition group-hover:bg-brand-500 group-hover:text-white dark:bg-white/10 dark:text-zinc-300">
                    <Download class="size-4" />
                  </span>
                </a>
              ))}
            </div>
          )}

          {p.release && p.install && (
            <ol class="mt-8 grid gap-4 border-t border-zinc-200 pt-8 sm:grid-cols-3 dark:border-white/10">
              {p.install.map((step, i) => (
                <li class="flex gap-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
                  <span class="grid size-6 shrink-0 place-items-center rounded-full bg-zinc-100 text-xs font-semibold text-zinc-900 dark:bg-white/10 dark:text-white">
                    {i + 1}
                  </span>
                  <span set:html={step} />
                </li>
              ))}
            </ol>
          )}

          {!p.release && (
            <div class="mt-8 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-dashed border-zinc-300 p-5 text-sm text-zinc-600 dark:border-white/15 dark:text-zinc-400">
              <p>
                {p.state === "soon"
                  ? `Multiwarden for ${p.name} is in development. The first release will appear here as soon as it’s published.`
                  : `Multiwarden for ${p.name} is on the roadmap. ${p.roadmap ?? ""}`}
              </p>
              <a href={p.repo ? `https://github.com/${p.repo}` : github.org} class="btn btn-secondary">
                <GitHubMark class="size-4" /> Follow on GitHub
              </a>
            </div>
          )}
        </section>
      ))
    }

    <p class="pt-4 text-center text-sm text-zinc-500">
      Looking for an older version? See <a class="text-brand-600 underline underline-offset-2 dark:text-brand-400" href="/releases/">all releases</a>.
    </p>
  </div>
</Base>

<script>
  // Highlight the build for the visitor's browser.
  import { detectBrowser } from "../lib/detect";
  const detected = detectBrowser();
  if (detected?.variant) {
    document.querySelector(`#browser [data-variant="${detected.variant}"]`)?.setAttribute("data-recommended", "");
  }
</script>
