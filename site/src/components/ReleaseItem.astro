---
import Download from "@lucide/astro/icons/download";
import ChevronDown from "@lucide/astro/icons/chevron-down";
import ExternalLink from "@lucide/astro/icons/external-link";
import PlatformIcon from "./PlatformIcon.astro";
import { formatDate, formatSize, type Release } from "../lib/releases";

interface Props {
  release: Release;
  latest?: boolean;
}
const { release: r, latest = false } = Astro.props;
---

<article class="relative pl-10 sm:pl-14" data-platform={r.platform} id={`${r.platform}-${r.tag}`}>
  <!-- Timeline dot -->
  <span
    class="absolute top-1 left-0 grid size-7 place-items-center rounded-full bg-white ring-1 ring-zinc-200 sm:size-9 dark:bg-zinc-900 dark:ring-white/10"
  >
    <PlatformIcon id={r.platform} class="size-3.5 text-brand-600 sm:size-4 dark:text-brand-400" />
  </span>

  <header class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
    <h3 class="text-lg font-semibold tracking-tight">{r.platformName} {r.version}</h3>
    {latest && <span class="pill bg-brand-500 text-white">Latest</span>}
    {r.prerelease && <span class="pill bg-amber-500/10 text-amber-700 ring-1 ring-amber-500/20 ring-inset dark:text-amber-400">Pre-release</span>}
    <time datetime={r.date} class="text-sm text-zinc-500">{formatDate(r.date)}</time>
  </header>

  {
    r.downloads.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-2">
        {r.downloads.map((d) => (
          <a
            href={d.url}
            class="group inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium transition hover:border-brand-500/50 hover:text-brand-700 dark:border-white/10 dark:bg-white/5 dark:hover:border-brand-400/50 dark:hover:text-brand-300"
          >
            <Download class="size-3.5 text-zinc-400 transition group-hover:text-current" />
            {d.label}
            <span class="text-xs font-normal text-zinc-400">{formatSize(d.size)}</span>
          </a>
        ))}
      </div>
    )
  }

  <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
    {
      r.notesHtml && (
        <details class="group/notes w-full">
          <summary class="inline-flex cursor-pointer list-none items-center gap-1 font-medium text-zinc-600 hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-white [&::-webkit-details-marker]:hidden">
            Release notes
            <ChevronDown class="size-4 transition group-open/notes:rotate-180" />
          </summary>
          <div class="prose-notes card mt-3 max-h-96 overflow-auto p-5" set:html={r.notesHtml} />
        </details>
      )
    }
    <a href={r.url} class="inline-flex items-center gap-1 text-zinc-500 hover:text-zinc-950 dark:hover:text-white">
      On GitHub <ExternalLink class="size-3.5" />
    </a>
    {
      r.extras.map((x) => (
        <a href={x.url} class="text-zinc-500 hover:text-zinc-950 dark:hover:text-white">
          {/-source-/.test(x.name) ? "Source code" : x.name} <span class="text-xs text-zinc-400">({formatSize(x.size)})</span>
        </a>
      ))
    }
  </div>
</article>
