---
// An illustration of Multiwarden's inline autofill menu offering logins from three accounts.
// Pure HTML and CSS; the animation plays once, then the highlight keeps cycling.
import KeyRound from "@lucide/astro/icons/key-round";
import Lock from "@lucide/astro/icons/lock";
import Check from "@lucide/astro/icons/check";

const rows = [
  { user: "alex@example.com", account: "Personal", color: "bg-acct-personal", initials: "AP" },
  { user: "alex@acme.co", account: "Work", color: "bg-acct-work", initials: "AW" },
  { user: "household", account: "Family", color: "bg-acct-family", initials: "FA" },
];
---

<div class="demo relative mx-auto w-full max-w-xl" aria-hidden="true">
  <!-- Glow behind the window -->
  <div
    class="absolute -inset-10 -z-10 rounded-[3rem] bg-gradient-to-tr from-brand-500/30 via-violet-500/20 to-fuchsia-400/20 blur-3xl"
  >
  </div>

  <div
    class="overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-2xl shadow-brand-950/10 dark:border-white/10 dark:bg-zinc-900 dark:shadow-black/40"
  >
    <!-- Browser chrome -->
    <div class="flex items-center gap-3 border-b border-zinc-200 bg-zinc-50 px-4 py-3 dark:border-white/10 dark:bg-zinc-900">
      <div class="flex gap-1.5">
        <span class="size-3 rounded-full bg-zinc-300 dark:bg-zinc-700"></span>
        <span class="size-3 rounded-full bg-zinc-300 dark:bg-zinc-700"></span>
        <span class="size-3 rounded-full bg-zinc-300 dark:bg-zinc-700"></span>
      </div>
      <div
        class="flex flex-1 items-center gap-2 rounded-lg bg-white px-3 py-1.5 text-xs text-zinc-500 ring-1 ring-zinc-200 dark:bg-zinc-800 dark:text-zinc-400 dark:ring-white/10"
      >
        <Lock class="size-3" />
        code.example.com/login
      </div>
      <img src="/logo.png" alt="" class="size-5 rounded" />
    </div>

    <!-- Page -->
    <div class="px-6 pt-7 pb-44 sm:px-10">
      <div class="mx-auto max-w-xs">
        <div class="mb-6 h-3 w-24 rounded-full bg-zinc-200 dark:bg-zinc-700"></div>
        <label class="mb-1.5 block text-xs font-medium text-zinc-500">Email</label>
        <div
          class="field flex h-10 items-center rounded-lg border-2 border-brand-500 bg-white px-3 text-sm dark:bg-zinc-950"
        >
          <span class="caret h-4 w-px bg-zinc-900 dark:bg-zinc-100"></span>
        </div>
        <div class="relative">
          <!-- Inline menu -->
          <div
            class="menu absolute top-2 right-0 left-0 z-10 overflow-hidden rounded-xl border border-zinc-200 bg-white p-1.5 shadow-xl dark:border-white/10 dark:bg-zinc-800"
          >
            {
              rows.map((row, i) => (
                <div class="row flex items-center gap-3 rounded-lg px-2.5 py-2" style={`--i:${i}`}>
                  <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-zinc-100 text-zinc-500 dark:bg-white/10 dark:text-zinc-300">
                    <KeyRound class="size-4" />
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block truncate text-[13px] font-medium text-zinc-900 dark:text-zinc-100">Example Code</span>
                    <span class="block truncate text-xs text-zinc-500 dark:text-zinc-400">{row.user}</span>
                  </span>
                  <span class="pill shrink-0 bg-zinc-100 text-zinc-700 dark:bg-white/10 dark:text-zinc-200">
                    <span class={`grid size-4 place-items-center rounded-full text-[8px] font-bold text-white ${row.color}`}>
                      {row.initials}
                    </span>
                    {row.account}
                  </span>
                </div>
              ))
            }
            <div class="mt-1 border-t border-zinc-100 px-2.5 pt-2 pb-1 text-[11px] text-zinc-400 dark:border-white/10">
              3 vaults unlocked
            </div>
          </div>
        </div>
        <div class="mt-4 mb-1.5 h-2.5 w-16 rounded-full bg-zinc-200 dark:bg-zinc-700"></div>
        <div class="h-10 rounded-lg border border-zinc-200 dark:border-white/10"></div>
      </div>
    </div>
  </div>

  <!-- Floating save prompt -->
  <div
    class="toast absolute z-20 -right-3 -bottom-8 w-64 rounded-xl border border-zinc-200 bg-white/90 p-3.5 shadow-2xl backdrop-blur-xl sm:-right-10 dark:border-white/10 dark:bg-zinc-800/90"
  >
    <div class="flex items-center gap-2 text-xs font-semibold text-zinc-900 dark:text-zinc-100">
      <span class="grid size-5 place-items-center rounded-full bg-emerald-500 text-white"><Check class="size-3" /></span>
      Save login to
    </div>
    <div
      class="mt-2.5 flex items-center justify-between rounded-lg bg-zinc-100 px-2.5 py-1.5 text-xs text-zinc-700 dark:bg-white/10 dark:text-zinc-200"
    >
      <span class="flex items-center gap-2">
        <span class="size-2 rounded-full bg-acct-work"></span>
        Work · alex@acme.co
      </span>
      <span class="text-zinc-400">▾</span>
    </div>
    <div class="mt-1.5 text-[11px] text-zinc-400">Remembered for this site</div>
  </div>
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .menu {
      animation: menu-in 0.6s var(--ease-out-expo) 0.5s both;
      transform-origin: top center;
    }
    .row {
      animation:
        row-in 0.5s var(--ease-out-expo) calc(0.7s + var(--i) * 0.09s) both,
        row-hover 6s ease-in-out calc(1.6s + var(--i) * 2s) infinite;
    }
    .toast {
      animation:
        toast-in 0.8s var(--ease-out-expo) 1.4s both,
        float 6s ease-in-out 2.2s infinite;
    }
    .caret {
      animation: blink 1s steps(1) infinite;
    }
    .field {
      animation: focus-ring 0.6s ease-out 0.2s both;
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.97);
    }
  }
  @keyframes row-in {
    from {
      opacity: 0;
      transform: translateX(-8px);
    }
  }
  @keyframes row-hover {
    0%,
    30%,
    100% {
      background: transparent;
    }
    5%,
    25% {
      background: color-mix(in oklab, #5e5feb 10%, transparent);
    }
  }
  @keyframes toast-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.96);
    }
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes focus-ring {
    from {
      border-color: transparent;
      box-shadow: none;
    }
    to {
      box-shadow: 0 0 0 4px color-mix(in oklab, #5e5feb 15%, transparent);
    }
  }
</style>
