---
interface Props {
  status: "available" | "soon" | "planned";
}
const { status } = Astro.props;
const styles = {
  available: "bg-emerald-500/10 text-emerald-700 ring-emerald-500/20 dark:text-emerald-400",
  soon: "bg-brand-500/10 text-brand-700 ring-brand-500/20 dark:text-brand-300",
  planned: "bg-zinc-500/10 text-zinc-600 ring-zinc-500/20 dark:text-zinc-400",
}[status];
const label = { available: "Available", soon: "Coming soon", planned: "Planned" }[status];
---

<span class={`pill ring-1 ring-inset ${styles}`}>
  {status === "available" && <span class="size-1.5 rounded-full bg-emerald-500" />}
  {label}
</span>
