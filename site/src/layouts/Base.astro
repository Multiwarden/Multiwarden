---
import "../styles/global.css";
import Moon from "@lucide/astro/icons/moon";
import Sun from "@lucide/astro/icons/sun";
import Menu from "@lucide/astro/icons/menu";
import GitHubMark from "../components/GitHubMark.astro";
import { github } from "../data/platforms";

interface Props {
  title?: string;
  description?: string;
}

const tagline = "All your vaults, working as one.";
const {
  title,
  description = "Multiwarden is an unofficial Bitwarden client that keeps every unlocked account in play: autofill, saving and passkeys from all your vaults at once.",
} = Astro.props;
const fullTitle = title ? `${title} · Multiwarden` : `Multiwarden · ${tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL("/logo.png", Astro.site);

const nav = [
  { href: "/#features", label: "Features" },
  { href: "/download/", label: "Download" },
  { href: "/releases/", label: "Releases" },
];
const path = Astro.url.pathname;
const isActive = (href: string) => !href.startsWith("/#") && path.startsWith(href.replace(/\/$/, ""));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <meta name="theme-color" content="#5e5feb" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Multiwarden" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // Apply the theme before paint, so there's no flash.
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem("theme");
        } catch {}
        const dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col font-sans">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-white focus:px-3 focus:py-2 focus:text-sm focus:shadow"
      >Skip to content</a
    >

    <header
      class="vt-header sticky top-0 z-40 border-b border-transparent bg-white/70 backdrop-blur-xl transition-colors data-[scrolled]:border-zinc-200/70 dark:bg-zinc-950/70 dark:data-[scrolled]:border-white/10"
      data-header
    >
      <nav class="container-page flex h-16 items-center gap-6" aria-label="Main">
        <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight">
          <img src="/logo.png" alt="" width="28" height="28" class="size-7 rounded-md" />
          <span>Multiwarden</span>
        </a>

        <ul class="ml-4 hidden items-center gap-1 text-sm md:flex">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class="rounded-full px-3 py-1.5 text-zinc-600 transition hover:text-zinc-950 aria-[current=page]:bg-zinc-100 aria-[current=page]:text-zinc-950 dark:text-zinc-400 dark:hover:text-white dark:aria-[current=page]:bg-white/10 dark:aria-[current=page]:text-white"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="ml-auto flex items-center gap-1.5">
          <a
            href={github.org}
            class="grid size-9 place-items-center rounded-full text-zinc-600 transition hover:bg-zinc-100 hover:text-zinc-950 dark:text-zinc-400 dark:hover:bg-white/10 dark:hover:text-white"
            aria-label="Multiwarden on GitHub"
          >
            <GitHubMark class="size-[18px]" />
          </a>
          <button
            type="button"
            data-theme-toggle
            class="grid size-9 place-items-center rounded-full text-zinc-600 transition hover:bg-zinc-100 hover:text-zinc-950 dark:text-zinc-400 dark:hover:bg-white/10 dark:hover:text-white"
            aria-label="Switch between light and dark mode"
          >
            <Sun class="hidden size-[18px] dark:block" />
            <Moon class="size-[18px] dark:hidden" />
          </button>
          <a href="/download/" class="btn btn-primary ml-2 hidden !py-2 sm:inline-flex">Download</a>

          <details class="group relative md:hidden">
            <summary
              class="grid size-9 cursor-pointer list-none place-items-center rounded-full text-zinc-600 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:bg-white/10 [&::-webkit-details-marker]:hidden"
              aria-label="Menu"
            >
              <Menu class="size-5" />
            </summary>
            <ul
              class="card absolute top-12 right-0 w-48 !bg-white p-2 text-sm shadow-xl dark:!bg-zinc-900"
            >
              {
                nav.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="block rounded-lg px-3 py-2 hover:bg-zinc-100 dark:hover:bg-white/10"
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
        </div>
      </nav>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mt-24 border-t border-zinc-200/80 dark:border-white/10">
      <div class="container-page grid gap-10 py-12 text-sm sm:grid-cols-[1.5fr_1fr_1fr]">
        <div class="max-w-sm">
          <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight">
            <img src="/logo.png" alt="" width="24" height="24" class="size-6 rounded-md" />
            Multiwarden
          </a>
          <p class="mt-3 text-zinc-500 dark:text-zinc-400">{tagline}</p>
        </div>
        <div>
          <h2 class="font-semibold">Product</h2>
          <ul class="mt-3 space-y-2 text-zinc-500 dark:text-zinc-400">
            <li><a class="hover:text-zinc-900 dark:hover:text-white" href="/download/">Download</a></li>
            <li><a class="hover:text-zinc-900 dark:hover:text-white" href="/releases/">Releases</a></li>
            <li><a class="hover:text-zinc-900 dark:hover:text-white" href="/privacy/">Privacy</a></li>
          </ul>
        </div>
        <div>
          <h2 class="font-semibold">Project</h2>
          <ul class="mt-3 space-y-2 text-zinc-500 dark:text-zinc-400">
            <li><a class="hover:text-zinc-900 dark:hover:text-white" href={github.org}>GitHub</a></li>
            <li><a class="hover:text-zinc-900 dark:hover:text-white" href={github.issues}>Report an issue</a></li>
            <li>
              <a class="hover:text-zinc-900 dark:hover:text-white" href="https://www.gnu.org/licenses/gpl-3.0.html"
                >GPL-3.0 licence</a
              >
            </li>
          </ul>
        </div>
      </div>
      <div class="container-page border-t border-zinc-200/80 py-6 text-xs text-zinc-500 dark:border-white/10">
        Multiwarden is an independent, open-source project. It is not affiliated with, endorsed by, or supported
        by Bitwarden, Inc. “Bitwarden” is a registered trademark of Bitwarden Inc., used here only to describe
        compatibility.
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {}
      });

      const header = document.querySelector<HTMLElement>("[data-header]");
      const onScroll = () => header?.toggleAttribute("data-scrolled", scrollY > 8);
      addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>
